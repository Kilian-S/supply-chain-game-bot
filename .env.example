# Copy to .env and fill in, or export these directly. Never commit real values.

# Game credentials
TEAM_ID=your_team_name
TEAM_PASSWORD=your_password

# Optional: override the game URL
# GAME_URL=https://op.responsive.net/sc/escribano/entry.html

# Optional: remote monitoring. Leave unset to run the bot without notifications.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
